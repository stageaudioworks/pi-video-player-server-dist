[Unit]
Description=Stage Audio Works video player - central manager
After=network.target

[Service]
Type=simple
User=saw-manager
Group=saw-manager
ExecStart=/usr/bin/python3 /opt/saw-manager/saw_manager.py
Environment=PYTHONUNBUFFERED=1
Environment=SAW_MANAGER_DATA=/var/lib/saw-manager
# Port, name and password: written by install.sh, kept across updates.
#   sudo bash install.sh --port 8080 | --name "Museum" | --new-password
EnvironmentFile=-/etc/saw-manager/manager.env
StateDirectory=saw-manager
StateDirectoryMode=0750
WorkingDirectory=/var/lib/saw-manager
Restart=always
RestartSec=3
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes

[Install]
WantedBy=multi-user.target
